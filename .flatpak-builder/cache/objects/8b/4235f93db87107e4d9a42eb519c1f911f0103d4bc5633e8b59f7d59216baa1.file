[Application]
name=org.anythingdevteam.wallpapersearcher
runtime=org.kde.Platform/x86_64/6.10
sdk=org.kde.Sdk/x86_64/6.10
command=wallpapersearcher

[Context]
shared=network;ipc;
sockets=x11;wayland;fallback-x11;
filesystems=home;xdg-config/kdeglobals:ro;

[Session Bus Policy]
com.canonical.AppMenu.Registrar=talk
org.kde.kconfig.notify=talk
org.kde.KGlobalSettings=talk

[Extension org.anythingdevteam.wallpapersearcher.Debug]
directory=lib/debug
autodelete=true
no-autodownload=true

[Build]
built-extensions=org.anythingdevteam.wallpapersearcher.Debug;